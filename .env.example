# PostgreSQL für pg Pool (existierende App)
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="abfertigung"
DB_USER="postgres"
DB_PASSWORD="your-password-here"

# PostgreSQL für Prisma (OCR Modelle)
DATABASE_URL="postgresql://postgres:your-password-here@localhost:5432/abfertigung"

# Redis (für OCR Worker)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"

# JWT Secret
JWT_SECRET="your-secret-key-change-this-in-production"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
