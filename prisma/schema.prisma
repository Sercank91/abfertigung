generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnmNrSequence {
  jahr         Int      @id
  letzteNummer Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("AnmNrSequence")
}

model Tenant {
  id             String          @id @default(uuid())
  name           String
  domain         String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  authorizations Authorization[]
  clearances     Clearance[]
  companies      Company[]
  goodsLocations GoodsLocation[]
  guarantees     Guarantee[]
  routes         Route[]
  users          User[]
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  email             String?            @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  role              String             @default("mitarbeiter")
  isActive          Boolean            @default(true)
  tenantId          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clearancesCreated Clearance[]        @relation("ClearanceCreatedBy")
  clearancesUpdated Clearance[]        @relation("ClearanceUpdatedBy")
  clearanceHistory  ClearanceHistory[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
}

model Guarantee {
  id          String             @id @default(uuid())
  name        String
  description String?
  isActive    Boolean            @default(true)
  tenantId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  clearances  Clearance[]
  companies   CompanyGuarantee[]
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Company {
  id         String             @id @default(uuid())
  name       String
  country    String
  address    String
  postalCode String
  city       String
  emails     String[]
  phones     String[]
  isActive   Boolean            @default(true)
  tenantId   String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  clearances Clearance[]
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guarantees CompanyGuarantee[]

  @@index([tenantId])
  @@index([tenantId, name])
}

model CompanyGuarantee {
  id          String    @id @default(uuid())
  companyId   String
  guaranteeId String
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  guarantee   Guarantee @relation(fields: [guaranteeId], references: [id], onDelete: Cascade)

  @@unique([companyId, guaranteeId])
  @@index([companyId])
  @@index([guaranteeId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model CustomsOffice {
  id                      String               @id @default(uuid())
  code                    String               @unique
  name                    String
  countryCode             String
  city                    String?
  address                 String?
  isActive                Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  searchText              String?
  declarations            Declaration[]
  routeTransitOffices     RouteTransitOffice[]
  clearancesDeparture     Clearance[]          @relation("ClearanceDepartureOffice")
  clearancesDispatch      Clearance[]          @relation("ClearanceDispatchOffice")
  clearancesDestination   Clearance[]          @relation("ClearanceDestinationOffice")

  @@index([countryCode])
  @@index([code])
  @@index([name])
}

model Route {
  id             String               @id @default(uuid())
  name           String
  countries      String[]
  description    String?
  isActive       Boolean              @default(true)
  tenantId       String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  clearances     Clearance[]
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transitOffices RouteTransitOffice[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RouteTransitOffice {
  id              String        @id @default(uuid())
  routeId         String
  customsOfficeId String
  order           Int
  createdAt       DateTime      @default(now())
  customsOffice   CustomsOffice @relation(fields: [customsOfficeId], references: [id])
  route           Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, customsOfficeId])
  @@index([routeId])
}

model GoodsLocation {
  id          String      @id @default(uuid())
  tenantId    String
  name        String
  code        String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  clearances  Clearance[]
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("GoodsLocation")
}

model Authorization {
  id          String      @id @default(uuid())
  name        String
  description String?
  code        String
  isActive    Boolean     @default(true)
  tenantId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clearances  Clearance[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, name])
}

model Clearance {
  id                  String             @id @default(uuid())
  lrn                 String
  companyId           String
  guaranteeId         String
  licensePlate        String
  licensePlateCountry String
  hasSecondPlate      Boolean            @default(false)
  secondLicensePlate  String?
  secondPlateCountry  String?
  routeId             String?
  simplifiedProcedure Boolean            @default(false)
  goodsLocationId     String?
  authorizationId     String?
  departureOfficeId   String?
  dispatchOfficeId    String?
  destinationOfficeId String?
  registrationDate    DateTime           @default(now())
  arrivalDate         DateTime
  status              String             @default("in_bearbeitung")
  tenantId            String
  createdById         String
  updatedById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  anmNr               String?
  authorization       Authorization?     @relation(fields: [authorizationId], references: [id])
  company             Company            @relation(fields: [companyId], references: [id])
  createdBy           User               @relation("ClearanceCreatedBy", fields: [createdById], references: [id])
  goodsLocation       GoodsLocation?     @relation(fields: [goodsLocationId], references: [id])
  guarantee           Guarantee          @relation(fields: [guaranteeId], references: [id])
  route               Route?             @relation(fields: [routeId], references: [id])
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy           User?              @relation("ClearanceUpdatedBy", fields: [updatedById], references: [id])
  departureOffice     CustomsOffice?     @relation("ClearanceDepartureOffice", fields: [departureOfficeId], references: [id])
  dispatchOffice      CustomsOffice?     @relation("ClearanceDispatchOffice", fields: [dispatchOfficeId], references: [id])
  destinationOffice   CustomsOffice?     @relation("ClearanceDestinationOffice", fields: [destinationOfficeId], references: [id])
  history             ClearanceHistory[]
  declarations        Declaration[]

  @@unique([tenantId, lrn])
  @@unique([tenantId, anmNr])
  @@index([tenantId])
  @@index([tenantId, lrn])
  @@index([tenantId, anmNr])
  @@index([tenantId, status])
  @@index([companyId])
  @@index([departureOfficeId])
  @@index([dispatchOfficeId])
  @@index([destinationOfficeId])
}

model Declaration {
  id                  String           @id @default(uuid())
  lrn                 String
  clearanceId         String
  destinationOfficeId String
  mrn                 String?
  registrationNumber  String?
  declarationType     String
  status              String           @default("neu")
  totalGrossWeight    Float?
  totalPackages       Int?
  totalValue          Float?
  currency            String?
  tenantId            String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  clearance           Clearance        @relation(fields: [clearanceId], references: [id], onDelete: Cascade)
  destinationOffice   CustomsOffice    @relation(fields: [destinationOfficeId], references: [id])
  exportDocuments     ExportDocument[]

  @@unique([tenantId, lrn])
  @@index([tenantId])
  @@index([clearanceId])
  @@index([tenantId, lrn])
}

model ExportDocument {
  id                 String      @id @default(uuid())
  declarationId      String
  positionNumber     Int
  mrnNumber          String
  mrnType            String      @default("NMRN")
  procedureCode      String
  declarationType    String
  senderName         String
  senderAddress      String
  senderPostalCode   String
  senderCity         String
  senderCountry      String
  receiverName       String
  receiverAddress    String
  receiverPostalCode String
  receiverCity       String
  receiverCountry    String
  hsCode             String
  description        String
  netWeight          Float
  grossWeight        Float
  packages           Int
  packageType        String      @default("PK")
  value              Float
  currency           String
  invoiceNumber      String
  dispatchCountry    String
  destinationCountry String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  declaration        Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@index([declarationId])
  @@index([mrnNumber])
}

model ClearanceHistory {
  id          String    @id @default(uuid())
  clearanceId String
  action      String
  description String
  userId      String
  createdAt   DateTime  @default(now())
  clearance   Clearance @relation(fields: [clearanceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([clearanceId])
  @@index([userId])
}

// ============================================
// OCR-System Models (für Python Worker)
// ============================================

model OcrDocument {
  id            String     @id @default(uuid())
  clearanceId   String
  fileName      String
  fileSize      Int
  fileType      String     // "application/pdf", "image/jpeg", etc.
  fileData      Bytes?     // Optional: Datei in DB speichern
  filePath      String?    // Oder: Pfad zu Datei auf Disk
  status        String     @default("pending") // "pending", "processing", "completed", "failed"
  ocrJobId      String?    // Celery Task ID
  progress      Int        @default(0)
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  shipments     Shipment[]

  @@index([clearanceId])
  @@index([status])
  @@index([ocrJobId])
}

model Shipment {
  id                  String             @id @default(uuid())
  ocrDocumentId       String
  clearanceId         String
  declarationId       String?            // Später zugeordnet zu Declaration
  mrn                 String?            // MRN-Nummer (25NLBRHOG51LW45DA5)
  documentType        String?            // "EX1", "T1", "N821"
  procedureType       String?            // "T1", "T2", "T-"
  commonSender        Json?              // { name, address, zip, city, country }
  commonReceiver      Json?              // { name, address, zip, city, country }
  commonOriginCountry String?            // "DE"
  commonDestCountry   String?            // "TR"
  totalPackages       Int?
  totalGrossWeight    Float?
  totalNetWeight      Float?
  totalValue          Float?
  currency            String?
  invoiceNumbers      String[]           // ["INV-001", "INV-002"]
  verified            Boolean            @default(false) // Vom Benutzer geprüft
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  ocrDocument         OcrDocument        @relation(fields: [ocrDocumentId], references: [id], onDelete: Cascade)
  positions           ShipmentPosition[]

  @@index([ocrDocumentId])
  @@index([clearanceId])
  @@index([declarationId])
  @@index([mrn])
}

model ShipmentPosition {
  id                 String   @id @default(uuid())
  shipmentId         String
  orderNumber        Int      // 1, 2, 3, ...
  hsCode             String
  description        String
  netWeight          Float
  grossWeight        Float    @default(0) // Nur bei orderNumber = 1
  procedure          String?  // "1010", "3171", "3151", etc.
  procedureType      String?  // "T1", "T2"
  sender             Json?    // Nur wenn abweichend von commonSender
  receiver           Json?    // Nur wenn abweichend von commonReceiver
  originCountry      String?  // Nur wenn abweichend
  destinationCountry String?  // Nur wenn abweichend
  value              Float?
  currency           String?
  invoiceNumber      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderNumber])
  @@index([shipmentId])
  @@index([hsCode])
}
